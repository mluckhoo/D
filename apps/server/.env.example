# Server
PORT=8080
HOST=0.0.0.0

# NVIDIA Audio2Face-3D NIM
# Get your API key from https://build.nvidia.com/nvidia/audio2face-3d
NVIDIA_API_KEY=nvapi-xxxx
A2F_ENDPOINT=grpc.nvcf.nvidia.com:443
A2F_FUNCTION_ID=your-function-id

# OpenAI (for Whisper STT + GPT)
OPENAI_API_KEY=sk-xxxx

# ElevenLabs (for TTS)
ELEVENLABS_API_KEY=xxxx
ELEVENLABS_VOICE_ID=xxxx

# NVIDIA PersonaPlex (Phase 4)
# PERSONAPLEX_URL=ws://localhost:8998
# PERSONAPLEX_VOICE=NATF2
